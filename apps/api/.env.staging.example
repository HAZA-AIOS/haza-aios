# =============================================================================
# HAZA AIOS — Staging API Environment Configuration Template
# Environment: Staging (Dedicated Isolated Infrastructure)
# =============================================================================

# Node Environment
NODE_ENV=production

# Server Binding
API_HOST=0.0.0.0
PORT=8080

# Web Origins & CORS (Staging Frontend)
WEB_ORIGIN=https://staging.haza-aios.com
WEB_ORIGINS=https://staging.haza-aios.com
APP_URL=https://staging.haza-aios.com

# Staging Database Configuration (Isolated Railway MySQL)
# Dedicated Staging Database - NEVER set this to production database
DATABASE_HOST=mysql-staging.railway.internal
DATABASE_PORT=3306
DATABASE_NAME=haza_aios_staging
DATABASE_USER=haza_staging_user
DATABASE_PASSWORD=<STAGING_DATABASE_PASSWORD_REDACTED>
DATABASE_POOL_LIMIT=10

# Email Delivery (Staging - Sandbox or Mock)
RESEND_API_KEY=<STAGING_RESEND_API_KEY_OR_SANDBOX>
EMAIL_FROM=staging@haza-aios.com

# Access & Registration Policy (Restricted in Staging)
REGISTRATION_ALLOWED_EMAILS=*@staging.haza-aios.com

# Logging & Diagnostic Monitoring
LOG_LEVEL=debug
API_BODY_LIMIT_BYTES=1048576
