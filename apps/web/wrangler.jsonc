{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haza-aios",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "haza-aios-staging",
      "routes": [
        {
          "pattern": "staging.haza-aios.com/*",
          "zone_name": "haza-aios.com"
        }
      ]
    }
  }
}
